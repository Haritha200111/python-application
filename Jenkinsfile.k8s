
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKERHUB_REPO = 'haritharavichandran/python-api'
        K8S_NAMESPACE = 'python-app'
        DEPLOYMENT_NAME = 'python-api'
        CONTAINER_NAME = 'python-api'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Branch: ${BRANCH_NAME}"
                    echo "Commit:"
                    git rev-parse --short HEAD
                '''
            }
        }

        stage('Preflight') {
            steps {
                sh '''
                    set -eu

                    echo "Checking required tools..."

                    git --version
                    python3 --version
                    docker --version
                    kubectl version --client

                    echo "Preflight checks completed."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -eu

                    echo "Creating Python virtual environment..."

                    python3 -m venv .venv

                    echo "Installing development dependencies..."

                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r requirements-dev.txt

                    echo "Dependencies installed successfully."
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    set -eu

                    echo "Running unit tests..."

                    .venv/bin/python -m pytest -v

                    echo "All tests passed."
                '''
            }
        }

        stage('Build and Push Docker Image') {
            when {
                branch 'main'
            }

            steps {
                script {
                    def shortCommit = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE = "${env.DOCKERHUB_REPO}:${env.BUILD_NUMBER}-${shortCommit}"
                }

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        set +x

                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        echo "Logging into Docker Hub..."

                        echo "$DOCKER_PASSWORD" |
                            docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        echo "Building Docker image: $IMAGE"

                        docker build --pull -t "$IMAGE" .

                        echo "Pushing Docker image..."

                        docker push "$IMAGE"

                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig-file',
                        variable: 'KUBECONFIG'
                    ),
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        set +x

                        echo "Checking Kubernetes access..."

                        kubectl get deployments -n "$K8S_NAMESPACE"

                        echo "Updating Docker registry secret..."

                        kubectl create secret docker-registry dockerhub-registry \
                            --docker-server=https://index.docker.io/v1/ \
                            --docker-username="$DOCKER_USER" \
                            --docker-password="$DOCKER_PASSWORD" \
                            --namespace="$K8S_NAMESPACE" \
                            --dry-run=client -o yaml |
                            kubectl apply -f -

                        echo "Applying Kubernetes Service..."

                        kubectl apply -f k8s/deployment/service.yaml

                        echo "Checking previous deployment..."

                        OLD_IMAGE=$(
                            kubectl get deployment "$DEPLOYMENT_NAME" \
                                -n "$K8S_NAMESPACE" \
                                -o jsonpath="{.spec.template.spec.containers[?(@.name=='${CONTAINER_NAME}')].image}" \
                                2>/dev/null || true
                        )

                        echo "Previous image: ${OLD_IMAGE:-none}"

                        echo "Applying new deployment..."

                        sed "s|__IMAGE__|${IMAGE}|g" \
                            k8s/deployment/deployment.yaml |
                            kubectl apply -f -

                        echo "Reading image configured in Kubernetes..."

                        DEPLOYED_IMAGE=$(
                            kubectl get deployment "$DEPLOYMENT_NAME" \
                                -n "$K8S_NAMESPACE" \
                                -o jsonpath="{.spec.template.spec.containers[?(@.name=='${CONTAINER_NAME}')].image}"
                        )

                        echo "Image configured in Deployment: $DEPLOYED_IMAGE"

                        echo "Waiting for deployment rollout..."

                        if kubectl rollout status \
                            deployment/"$DEPLOYMENT_NAME" \
                            -n "$K8S_NAMESPACE" \
                            --timeout=180s
                        then
                            echo "Deployment successful."

                        else
                            echo "Deployment failed."

                            echo "======================================"
                            echo "COLLECTING DIAGNOSTICS BEFORE ROLLBACK"
                            echo "======================================"

                            echo "Current application pods:"

                            kubectl get pods \
                                -n "$K8S_NAMESPACE" \
                                -o wide || true

                            echo "ReplicaSets:"

                            kubectl get replicasets \
                                -n "$K8S_NAMESPACE" \
                                -o wide || true

                            echo "Deployment details:"

                            kubectl describe deployment "$DEPLOYMENT_NAME" \
                                -n "$K8S_NAMESPACE" || true

                            echo "Recent namespace events:"

                            kubectl get events \
                                -n "$K8S_NAMESPACE" \
                                --sort-by='.lastTimestamp' |
                                tail -n 40 || true

                            echo "Identifying pods using the deployed image..."

                            NEW_PODS=""

                            for POD in $(kubectl get pods \
                                -n "$K8S_NAMESPACE" \
                                -l app=python-api \
                                -o name || true)
                            do
                                POD_IMAGE=$(
                                    kubectl get "$POD" \
                                        -n "$K8S_NAMESPACE" \
                                        -o jsonpath="{.spec.containers[?(@.name=='${CONTAINER_NAME}')].image}" \
                                        2>/dev/null || true
                                )

                                if [ "$POD_IMAGE" = "$DEPLOYED_IMAGE" ]; then
                                    NEW_PODS="$NEW_PODS $POD"
                                fi
                            done

                            if [ -n "$NEW_PODS" ]; then

                                for POD in $NEW_PODS
                                do
                                    echo "======================================"
                                    echo "Diagnostics for $POD"
                                    echo "======================================"

                                    echo "Pod description:"

                                    kubectl describe "$POD" \
                                        -n "$K8S_NAMESPACE" || true

                                    echo "Current container logs:"

                                    kubectl logs "$POD" \
                                        -n "$K8S_NAMESPACE" \
                                        -c "$CONTAINER_NAME" \
                                        --tail=100 || true

                                    echo "Previous container logs, if available:"

                                    kubectl logs "$POD" \
                                        -n "$K8S_NAMESPACE" \
                                        -c "$CONTAINER_NAME" \
                                        --previous \
                                        --tail=100 || true
                                done

                            else
                                echo "No pods using the deployed image were found."
                            fi

                            echo "======================================"
                            echo "STARTING ROLLBACK"
                            echo "======================================"

                            if [ -n "$OLD_IMAGE" ]; then

                                echo "Rolling back to previous revision..."

                                if kubectl rollout undo \
                                    deployment/"$DEPLOYMENT_NAME" \
                                    -n "$K8S_NAMESPACE"
                                then
                                    echo "Waiting for rollback to complete..."

                                    kubectl rollout status \
                                        deployment/"$DEPLOYMENT_NAME" \
                                        -n "$K8S_NAMESPACE" \
                                        --timeout=180s

                                    echo "Verifying restored image..."

                                    RESTORED_IMAGE=$(
                                        kubectl get deployment "$DEPLOYMENT_NAME" \
                                            -n "$K8S_NAMESPACE" \
                                            -o jsonpath="{.spec.template.spec.containers[?(@.name=='${CONTAINER_NAME}')].image}"
                                    )

                                    echo "Previous image: $OLD_IMAGE"
                                    echo "Restored image: $RESTORED_IMAGE"

                                    if [ "$RESTORED_IMAGE" != "$OLD_IMAGE" ]; then
                                        echo "ERROR: Rollback image verification failed."
                                        exit 1
                                    fi

                                    echo "Rollback completed and verified successfully."

                                else
                                    echo "Rollback command failed."
                                    exit 1
                                fi

                            else
                                echo "No previous deployment exists."
                                echo "Initial deployment needs manual correction."
                            fi

                            echo "Final deployment status:"

                            kubectl get deployments \
                                -n "$K8S_NAMESPACE" || true

                            kubectl get pods \
                                -n "$K8S_NAMESPACE" \
                                -o wide || true

                            echo "Deployment failed. Check diagnostics above."

                            exit 1
                        fi

                        echo "Final deployment status:"

                        kubectl get deployments -n "$K8S_NAMESPACE"

                        kubectl get pods \
                            -n "$K8S_NAMESPACE" \
                            -o wide

                        echo "Kubernetes deployment completed successfully."
                    '''
                }
            }
        }


    }

    post {

        success {
            echo "CI/CD pipeline completed successfully for ${BRANCH_NAME}."

            script {
                if (env.BRANCH_NAME == 'main') {
                    echo "Docker image: ${env.IMAGE}"
                    echo "Kubernetes namespace: ${env.K8S_NAMESPACE}"
                } else {
                    echo "Tests completed. Deployment skipped for non-main branch."
                }
            }
        }

        failure {
            echo "CI/CD pipeline failed for ${BRANCH_NAME}."
            echo "Check the stage logs for failure details."
            echo "If deployment failed, diagnostics were collected before rollback."
        }

        always {
            echo "Pipeline execution completed."
        }
    }
}
